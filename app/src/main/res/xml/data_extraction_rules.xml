<?xml version="1.0" encoding="utf-8"?>
<!-- Los resultados del análisis (hashes, IDs de MediaStore, selección pendiente) solo tienen
     sentido en este teléfono, así que se excluyen de la copia en la nube y de la transferencia
     entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
