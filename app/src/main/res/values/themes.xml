<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la ventana antes de que Compose dibuje: oscuro para evitar un destello blanco,
         ya que el tema predeterminado de la app es oscuro. -->
    <style name="Theme.Cleanup" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
